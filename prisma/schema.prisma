// This file is generated by Prisma
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================
// TENANT & USER MANAGEMENT
// ============================================

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  password  String // bcrypt hashed
  firstName String
  lastName  String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships  Membership[]
  agentActions AgentAction[]

  @@map("users")
}

model Organization {
  id        String   @id @default(uuid())
  name      String
  slug      String   @unique
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  memberships   Membership[]
  channels      Channel[]
  conversations Conversation[]
  messages      Message[]
  events        Event[]
  agentActions  AgentAction[]
  settings      Settings?
  skillConfigs  SkillConfig[]
  apiKeys       ApiKey[]
  webhookLogs   WebhookLog[]
  followupTasks FollowupTask[]

  @@map("organizations")
}

enum Role {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

model Membership {
  id        String   @id @default(uuid())
  role      Role     @default(MEMBER)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([userId, orgId])
  @@index([orgId])
  @@map("memberships")
}

// ============================================
// CHANNELS (WhatsApp, WebChat, Email, etc.)
// ============================================

enum ChannelType {
  WHATSAPP
  WEBCHAT
  EMAIL
  INSTAGRAM
  TELEGRAM
}

enum ChannelStatus {
  ACTIVE
  INACTIVE
  ERROR
}

model Channel {
  id          String        @id @default(uuid())
  type        ChannelType
  status      ChannelStatus @default(ACTIVE)
  name        String // e.g., "Main WhatsApp", "Website Chat"
  phoneNumber String? // For WhatsApp
  webhookUrl  String?
  metadata    Json? // Channel-specific config
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  conversations Conversation[]
  messages      Message[]

  @@index([orgId])
  @@index([type, orgId])
  @@map("channels")
}

// ============================================
// CONVERSATIONS & MESSAGES
// ============================================

enum ConversationStatus {
  OPEN
  CLOSED
  ARCHIVED
}

model Conversation {
  id            String             @id @default(uuid())
  externalId    String? // External platform ID (e.g., WhatsApp conversation ID)
  status        ConversationStatus @default(OPEN)
  customerName  String?
  customerPhone String?
  customerEmail String?
  lastMessageAt DateTime?
  metadata      Json?
  createdAt     DateTime           @default(now())
  updatedAt     DateTime           @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  messages     Message[]
  agentActions AgentAction[]
  followupTasks FollowupTask[]

  @@unique([orgId, channelId, externalId])
  @@index([orgId, status])
  @@index([channelId])
  @@map("conversations")
}

enum MessageDirection {
  INBOUND
  OUTBOUND
}

enum MessageStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

model Message {
  id          String           @id @default(uuid())
  externalId  String? // Platform message ID
  direction   MessageDirection
  status      MessageStatus    @default(PENDING)
  content     String           @db.Text
  contentType String           @default("text") // text, image, document, etc.
  metadata    Json?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([conversationId])
  @@index([channelId])
  @@index([createdAt])
  @@map("messages")
}

// ============================================
// EVENTS (Normalized Input)
// ============================================

enum EventType {
  MESSAGE_RECEIVED
  MESSAGE_STATUS
  CONVERSATION_OPENED
  CONVERSATION_CLOSED
  SCHEDULED_FOLLOWUP
  DAILY_SUMMARY
  WEB_CHECK
  SYSTEM
}

enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

model Event {
  id        String      @id @default(uuid())
  type      EventType
  status    EventStatus @default(PENDING)
  payload   Json
  metadata  Json?
  error     String?
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  agentActions AgentAction[]

  @@index([orgId, status])
  @@index([type, status])
  @@index([createdAt])
  @@map("events")
}

// ============================================
// AGENT ORCHESTRATOR & ACTIONS
// ============================================

enum AgentActionType {
  REPLY
  FOLLOWUP_SENT
  FOLLOWUP
  SUMMARY
  WEB_CHECK
  ESCALATE
  CREATE_TASK
  SEND_EMAIL
}

enum AgentActionStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

model AgentAction {
  id            String            @id @default(uuid())
  type          AgentActionType
  status        AgentActionStatus @default(PENDING)
  toolName      String // LLM tool that was called
  toolInput     Json // Input to the tool
  toolOutput    Json? // Output from the tool
  error         String?
  llmModel      String?
  llmTokens     Int?
  executionTime Int? // ms
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  conversationId String?
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([orgId, status])
  @@index([eventId])
  @@index([conversationId])
  @@index([createdAt])
  @@map("agent_actions")
}

// ============================================
// SETTINGS & CONFIGURATION
// ============================================

model Settings {
  id String @id @default(uuid())

  // Agent behavior
  agentName           String  @default("Bizta")
  agentPersonality    String? @db.Text
  autoReply           Boolean @default(true)
  autoFollowup        Boolean @default(true)
  followupDelayHours  Float   @default(24)
  followupMessageTemplate String? @db.Text
  dailySummaryEnabled Boolean @default(true)
  dailySummaryTime    String  @default("09:00") // HH:mm format

  // Business context
  businessName        String?
  businessDescription String? @db.Text
  businessHours       Json? // { monday: {open: "09:00", close: "17:00"}, ... }
  timezone            String  @default("UTC")

  // Thresholds
  maxAutoRepliesPerDay Int      @default(100)
  escalationKeywords   String[] @default([])

  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId        String       @unique
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@map("settings")
}

model SkillConfig {
  id        String   @id @default(uuid())
  skillName String // "messaging", "followup", "summary", "webmonitor"
  isEnabled Boolean  @default(true)
  config    Json // Skill-specific configuration
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@unique([orgId, skillName])
  @@index([orgId])
  @@map("skill_configs")
}

// ============================================
// API KEYS & SECRETS (Encrypted)
// ============================================

enum ApiKeyType {
  WHATSAPP
  OPENAI
  EMAIL
  INSTAGRAM
  TELEGRAM
  WEBHOOK
}

model ApiKey {
  id             String     @id @default(uuid())
  type           ApiKeyType
  name           String
  encryptedValue String     @db.Text // Encrypted with libsodium
  isActive       Boolean    @default(true)
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  metadata       Json?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId, type])
  @@map("api_keys")
}

// ============================================
// WEBHOOK LOGS (Audit Trail)
// ============================================

model WebhookLog {
  id             String   @id @default(uuid())
  source         String // "whatsapp", "webchat", etc.
  method         String
  path           String
  headers        Json
  body           Json
  statusCode     Int?
  response       Json?
  ipAddress      String?
  verified       Boolean  @default(false)
  error          String?
  processingTime Int? // ms
  createdAt      DateTime @default(now())

  orgId        String?
  organization Organization? @relation(fields: [orgId], references: [id], onDelete: SetNull)

  @@index([orgId])
  @@index([source, createdAt])
  @@map("webhook_logs")
}

// ============================================
// FOLLOWUP TASKS (Automatic Reminders)
// ============================================

enum FollowupChannel {
  WHATSAPP
  EMAIL
  WEBCHAT
}

enum FollowupType {
  CUSTOMER_REMINDER
  OWNER_REMINDER
}

enum FollowupStatus {
  PENDING
  SENT
  CANCELLED
  FAILED
}

model FollowupTask {
  id              String          @id @default(cuid())
  customerPhone   String
  channel         FollowupChannel
  type            FollowupType
  status          FollowupStatus  @default(PENDING)
  scheduledAt     DateTime
  sentAt          DateTime?
  messageTemplate String          @db.Text
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  orgId        String
  organization Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([orgId, status])
  @@index([conversationId, status])
  @@index([scheduledAt, status])
  @@map("followup_tasks")
}
